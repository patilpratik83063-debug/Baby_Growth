# Copy to .env (git-ignored). `npm start` loads it automatically.

# --- AI: one OpenRouter key runs every model. Without it the app runs in mock mode. ---
OPENROUTER_API_KEY=
# GEO_LLM=mock                                  # force mock mode

# Models (OpenRouter slugs). Budget defaults shown; uncomment to upgrade any job.
# GEO_MODEL_WRITER=anthropic/claude-haiku-5.5      # articles      (upgrade: anthropic/claude-sonnet-5.5)
# GEO_MODEL_RESEARCH=anthropic/claude-haiku-5.5    # analysis, competitors, plan, research
# GEO_MODEL_FAST=anthropic/claude-haiku-5.5        # extraction
# GEO_ENGINE_CHATGPT=openai/gpt-5-nano
# GEO_ENGINE_CLAUDE=anthropic/claude-haiku-5.5
# GEO_ENGINE_GEMINI=google/gemini-2.5-flash-lite
# GEO_ENGINE_PERPLEXITY=perplexity/sonar
# GEO_SEARCH_ENGINE=parallel                       # web search backend: parallel ($0.001) | exa ($0.007) | native (provider price)
# GEO_SEARCH_MODE=fast

# --- Server ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# SECRET_KEY=             # encrypts stored integration credentials (default: data/secret.key)
# COOKIE_SECURE=1         # set in production behind HTTPS
# DATA_DIR=./data

# --- Login ---
# Owner login, applied once at startup (the oldest existing account takes this ID; the password is stored hashed).
# ADMIN_USERNAME=yourname
# ADMIN_PASSWORD=change-me-please
# ADMIN_RESET_PASSWORD=1   # reset the owner's password from ADMIN_PASSWORD on the next start
# ALLOW_SIGNUP=0           # 0 = personal deployment, only existing logins can sign in

# --- Limits (protect your OpenRouter credit) ---
# LIMIT_ARTICLES_PER_MONTH=60
# LIMIT_PROMPTS=20
# LIMIT_WEBSITES=10

# --- Tuning ---
# JOB_CONCURRENCY=3
# AUTOPILOT_INTERVAL_MS=60000
# BACKLINKS_PER_MONTH=8
